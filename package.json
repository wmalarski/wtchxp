{
  "name": "wtchxp",
  "version": "0.0.0",
  "description": "Windows XP themed components for SolidJS, built on Kobalte and XP.css.",
  "homepage": "https://github.com/wmalarski/wtchxp#readme",
  "bugs": {
    "url": "https://github.com/wmalarski/wtchxp/issues"
  },
  "license": "MIT",
  "author": "Wojtek Malarski <w.malarski@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmalarski/wtchxp.git"
  },
  "files": [
    "dist",
    "LICENSE-XP.CSS"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components/*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp dev",
    "generate:icons": "node scripts/generate-window-icons.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vp test && vp test --config vitest.ssr.config.ts",
    "test:ssr": "vp test --config vitest.ssr.config.ts",
    "check": "vp check",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "verify:tree-shaking": "node scripts/verify-tree-shaking.mjs",
    "verify:bundle": "vp run build && vp run check:bundle && vp run verify:tree-shaking",
    "prepublishOnly": "vp run verify:bundle",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@kobalte/core": "2.0.0-alpha.4",
    "@solidjs/diagnostics": "2.0.0-rc.16",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@solidjs/web": "2.0.0-rc.16",
    "@storybook/addon-docs": "^10.6.5",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "@types/postcss-url": "^10.0.4",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "^4.14.0",
    "bumpp": "^12.3.0",
    "eslint-plugin-solid": "0.18.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "postcss-url": "^10.1.4",
    "solid-js": "2.0.0-rc.16",
    "storybook": "^10.6.5",
    "storybook-solidjs-vite": "^10.7.4",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@kobalte/core": "^2.0.0-alpha.4",
    "@solidjs/web": "^2.0.0-rc.16",
    "@stylexjs/stylex": "^0.19.1",
    "solid-js": "^2.0.0-rc.16"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
